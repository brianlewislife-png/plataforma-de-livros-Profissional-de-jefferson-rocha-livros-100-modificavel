<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= settings.siteTitle %></title>
    <meta name="description" content="<%= settings.heroText %>" />
    <meta name="theme-color" content="#0d0d0f" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/png" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include('partials/topbar') %>
    <%- include('partials/installBanner') %>

    <section class="hero">
      <div class="container hero-content">
        <div>
          <p class="eyebrow"><%= settings.tagline %></p>
          <h1><%= settings.heroTitle %></h1>
          <p class="hero-text"><%= settings.heroText %></p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/livros">Explorar catálogo</a>
            <a class="btn btn-secondary" href="#promocoes">Ver promoções</a>
          </div>
        </div>
        <div class="hero-card">
          <p class="eyebrow">Hoje em destaque</p>
          <% if (books.length) { %>
            <h3><%= books[0].title %></h3>
            <p class="muted"><%= books[0].author %> · <%= books[0].category %></p>
            <div class="cover-mini"><%= String(books[0].title || 'L').charAt(0).toUpperCase() %></div>
            <div class="hero-actions">
              <a class="btn btn-primary small" href="/livro/<%= books[0].slug %>">Ver livro</a>
            </div>
          <% } else { %>
            <p class="muted">Novos títulos em breve.</p>
          <% } %>
        </div>
      </div>
    </section>

    <section id="destaques" class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <h2>Livros em destaque</h2>
            <p class="sub">Os favoritos da nossa coleção</p>
          </div>
          <a class="section-link" href="/livros">Ver todos →</a>
        </div>
        <div class="card-grid">
          <% books.forEach((book) => { %>
            <%- include('partials/bookCard', { book }) %>
          <% }) %>
        </div>
      </div>
    </section>

    <section id="lancamentos" class="section alt">
      <div class="container">
        <div class="section-header">
          <div>
            <h2>Lançamentos</h2>
            <p class="sub">As novidades mais recentes</p>
          </div>
          <a class="section-link" href="/livros">Ver todos →</a>
        </div>
        <div class="card-grid">
          <% latestBooks.forEach((book) => { %>
            <%- include('partials/bookCard', { book }) %>
          <% }) %>
        </div>
      </div>
    </section>

    <section id="promocoes" class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <h2>Promoções</h2>
            <p class="sub">Descontos imperdíveis por tempo limitado</p>
          </div>
          <a class="section-link" href="/livros">Ver todas →</a>
        </div>
        <div class="card-grid">
          <% promotions.forEach((book) => { %>
            <%- include('partials/bookCard', { book }) %>
          <% }) %>
        </div>
      </div>
    </section>

    <%- include('partials/footer') %>
    <script src="/js/app.js"></script>
  </body>
</html>
