<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin | <%= settings.siteTitle %></title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <main class="auth-page">
      <div class="auth-card">
        <h1>Área Administrativa</h1>
        <p class="auth-sub">Acesso restrito. Entre para gerenciar o site.</p>
        <% if (error) { %><p class="form-error"><%= error %></p><% } %>
        <form method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label>E-mail</label>
          <input type="email" name="email" placeholder="seu@email.com" autocomplete="username" />
          <label>Senha</label>
          <input type="password" name="password" placeholder="••••••••" autocomplete="current-password" />
          <button class="btn btn-primary" type="submit" style="margin-top:.8rem">Entrar</button>
        </form>
      </div>
    </main>
  </body>
</html>
