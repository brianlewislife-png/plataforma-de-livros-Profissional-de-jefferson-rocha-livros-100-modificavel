<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= mode === 'edit' ? 'Editar' : 'Novo' %> Livro | <%= settings.siteTitle %></title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <div class="admin-shell">
      <%- include('partials/sidebar') %>
      <main class="admin-main">
        <%- include('partials/topbar') %>
        <h1><%= mode === 'edit' ? 'Editar livro' : 'Novo livro' %></h1>
        <p class="page-sub">Preencha as informações do título.</p>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <%
          const links = book && Array.isArray(book.downloadLinks) ? book.downloadLinks : [];
          const primaryLink = links[0] || '';
          const extraLinks = links.slice(1).join('\n');
        %>
        <form method="post" action="<%= mode === 'edit' ? adminPath + '/livros/' + book.id + '/editar' : adminPath + '/livros' %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="form-grid">
            <div class="form-panel">
              <h3>Informações principais</h3>
              <p class="panel-sub">Dados básicos do livro.</p>
              <label>Título *</label>
              <input name="title" value="<%= book ? book.title : '' %>" required />
              <label>Subtítulo</label>
              <input name="subtitle" value="<%= book ? book.subtitle : '' %>" />
              <label>Descrição</label>
              <textarea name="description" rows="5"><%= book ? book.description : '' %></textarea>
              <label>Autor</label>
              <input name="author" value="<%= book ? book.author : '' %>" />
              <label>Editora</label>
              <input name="publisher" value="<%= book ? book.publisher : '' %>" />
            </div>

            <div class="form-panel">
              <h3>Publicação</h3>
              <p class="panel-sub">Slug, categoria e identificação.</p>
              <label>Slug</label>
              <input name="slug" value="<%= book ? book.slug : '' %>" placeholder="deixe em branco para gerar" />
              <label>Categoria</label>
              <input name="category" list="categories-list" value="<%= book ? book.category : '' %>" placeholder="digite ou selecione" />
              <datalist id="categories-list">
                <% settings.categories.forEach((cat) => { %>
                  <option value="<%= cat %>"></option>
                <% }) %>
              </datalist>
              <label>Faixa etária</label>
              <input name="ageRange" value="<%= book ? book.ageRange : 'L' %>" placeholder="ex.: L, 10+, 14+, 16+, 18+" />
              <label>Idioma</label>
              <input name="language" value="<%= book ? book.language : 'Português' %>" />
              <label>Páginas</label>
              <input name="pages" type="number" min="0" value="<%= book ? book.pages : 0 %>" />
              <label>Ano</label>
              <input name="year" type="number" value="<%= book ? book.year : 2026 %>" />
            </div>

            <div class="form-panel">
              <h3>Preço e status</h3>
              <p class="panel-sub">Venda, promoção e publicação.</p>
              <label>Status</label>
              <select name="status">
                <% ['Publicado', 'Rascunho', 'Arquivado'].forEach((st) => { %>
                  <option value="<%= st %>" <%= book && book.status === st ? 'selected' : '' %>><%= st %></option>
                <% }) %>
              </select>
              <label>Preço (R$)</label>
              <input name="price" type="number" step="0.01" min="0" value="<%= book ? book.price : 0 %>" />
              <label>Preço promocional (R$)</label>
              <input name="promoPrice" type="number" step="0.01" min="0" value="<%= book ? book.promoPrice : 0 %>" />
              <label>Desconto (%)</label>
              <input name="discount" type="number" min="0" max="100" value="<%= book ? book.discount : 0 %>" />
              <label>Avaliação (0–5)</label>
              <input name="rating" type="number" step="0.1" min="0" max="5" value="<%= book ? book.rating : 0 %>" />
              <div class="type-row">
                <span class="type-label">Tipo de venda</span>
                <label class="type-option">
                  <input type="radio" name="bookType" value="free" id="typeFree" <%= book && book.isFree ? 'checked' : '' %> /> <span>Livro gratuito</span>
                </label>
                <label class="type-option">
                  <input type="radio" name="bookType" value="paid" id="typePaid" <%= !book || !book.isFree ? 'checked' : '' %> /> <span>Livro pago</span>
                </label>
              </div>
              <div class="extra-checks">
                <label style="display:flex;align-items:center;gap:.5rem;margin:0">
                  <input type="checkbox" name="isPromotion" <%= book && book.isPromotion ? 'checked' : '' %> /> Promoção
                </label>
                <label style="display:flex;align-items:center;gap:.5rem;margin:0">
                  <input type="checkbox" name="featured" <%= book && book.featured ? 'checked' : '' %> /> Destaque
                </label>
              </div>

              <div class="download-field" id="downloadSection">
                <label>Link de download (arquivo) <span class="req">*</span> <span class="hint">(MediaFire ou Mega)</span></label>
                <input name="downloadLink" id="downloadLink" value="<%= primaryLink %>" placeholder="https://www.mediafire.com/... ou https://mega.nz/..." />
                <label>Links adicionais (um por linha)</label>
                <textarea name="downloadLinksExtra" rows="3" placeholder="https://drive.google.com/...&#10;https://exemplo.com/livro.pdf"><%= extraLinks %></textarea>
                <p class="hint">O usuário verá apenas o botão "Baixar", que abre este link.</p>
              </div>

              <div class="download-field whatsapp" id="whatsappSection">
                <label>Número do WhatsApp (venda) <span class="req">*</span></label>
                <input name="whatsappNumber" id="whatsappNumber" type="tel" value="<%= book ? book.whatsappNumber : '' %>" placeholder="5511999999999 (DDI + DDD + número)" />
                <p class="hint">Ao clicar em "Comprar", o usuário será redirecionado para este WhatsApp.</p>
              </div>
            </div>

            <div class="form-panel">
              <h3>Capa</h3>
              <p class="panel-sub">Imagem de capa do livro.</p>
              <label>URL da capa</label>
              <input name="coverUrl" value="<%= book ? book.coverUrl : '' %>" placeholder="https://..." />
            </div>
          </div>

          <div class="admin-actions">
            <button class="btn btn-primary" type="submit">Salvar</button>
            <a class="btn btn-secondary" href="<%= adminPath %>/livros">Cancelar</a>
          </div>
        </form>
      </main>
    </div>

    <script src="/js/admin-form.js"></script>
  </body>
</html>
